# Local PostgreSQL only. scripts/Start-Local.ps1 creates .env automatically.
CLASH_DB_PASSWORD=replace-with-a-random-local-password

# Hosted settings are configured in the provider secret store, not this file.
ConnectionStrings__Clash=Host=postgres;Port=5432;Database=clashinsights;Username=clash;Password=replace-me;SSL Mode=Require
Clash__ApiToken=replace-with-the-clash-api-token
Hosting__Hosted=true
Hosting__KnownProxies__0=replace-with-the-platform-proxy-ip
Hosting__DataProtectionPath=/var/lib/clash-insights/keys
Database__MigrateOnStartup=false
Auth__Enabled=true
Auth__Domain=your-tenant.eu.auth0.com
Auth__ClientId=replace-me
Auth__ClientSecret=replace-me
Auth__AllowedSubjects__0=auth0|replace-me
Tracking__Mode=Live
Tracking__ClanTags__0=replace-with-public-clan-tag-1
Tracking__ClanTags__1=replace-with-public-clan-tag-2
Tracking__ClanTags__2=replace-with-public-clan-tag-3
Tracking__ClanTags__3=replace-with-private-clan-tag
Tracking__PublicClanTags__0=replace-with-public-clan-tag-1
Tracking__PublicClanTags__1=replace-with-public-clan-tag-2
Tracking__PublicClanTags__2=replace-with-public-clan-tag-3
Sentry__Dsn=https://public-key@ingest.example/1
Sentry__BrowserDsn=https://public-key@ingest.example/2
Sentry__Release=clash-insights@replace-me
